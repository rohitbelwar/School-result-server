# School-result-server (existing)
PORT=3000
MONGODB_URI=mongodb://localhost:27017/school_db
JWT_SECRET=replace-with-a-long-random-string

# OMR Auto-Checker is mounted inside server1.js (same port; no PORT_OMR needed).
# Requires Node.js >= 22.5 because the licence backend uses node:sqlite.
# Use a persistent writable directory for SQLite data and signing secrets in production.
DATA_DIR=./OMR-AutoChecker/backend/data
# Production: set the exact allowed frontend origins for OMR customer API requests.
ALLOWED_ORIGINS=https://your-school-domain.example
TRUST_PROXY=0
# Used only when running the optional standalone server2.js.
# PORT_OMR=3001
# Set ADMIN_PASSWORD only for one-time administrator creation; never commit a real password.
# ADMIN_PASSWORD=
